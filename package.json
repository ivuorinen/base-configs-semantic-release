{
  "name": "@ivuorinen/semantic-release-config",
  "version": "1.1.23",
  "description": "ivuorinen's shareable configuration for semantic-release.",
  "author": {
    "name": "Ismo Vuorinen",
    "url": "https://github.com/ivuorinen"
  },
  "bugs": {
    "url": "https://github.com/ivuorinen/base-configs-semantic-release/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.10.0"
  },
  "files": [
    "index.cjs",
    "index.d.cts",
    "index.d.mts",
    "index.d.ts",
    "wrapper.mjs",
    "scripts/*"
  ],
  "homepage": "https://github.com/ivuorinen/base-configs-semantic-release#readme",
  "keywords": [
    "semantic-release-config",
    "semantic-release",
    "config",
    "ivuorinen"
  ],
  "license": "MIT",
  "type": "module",
  "main": "index.cjs",
  "module": "wrapper.mjs",
  "types": "index.d.ts",
  "exports": {
    "import": {
      "types": "./index.d.mts",
      "default": "./wrapper.mjs"
    },
    "require": {
      "types": "./index.d.cts",
      "default": "./index.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivuorinen/base-configs-semantic-release.git"
  },
  "scripts": {
    "lint": "eslint .",
    "postinstall": "node scripts/postinstall.cjs",
    "test": "yarn typecheck && node --test \"test/**/*.test.mjs\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ivuorinen/config-checker": "^2.2.17",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.0.0",
    "eslint-config-eslint": "^14.0.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "typescript": "^7.0.2"
  },
  "resolutions": {
    "picomatch": "^4.0.4",
    "undici": "^8.0.0"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f"
}
